@page "/passwords"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PasswordManager.Data
@using PasswordManager.Data.Models
@using PasswordManager.Services
@inject AppDbContext DbContext
@inject EncryptionService EncryptionService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Minhas Senhas</PageTitle>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2 style="color: var(--primary-color);">Cofre de Senhas</h2>
    <a href="/add-password" class="btn btn-primary">
        + Nova Senha
    </a>
</div>

@if (passwords == null)
{
    <p><em>Carregando...</em></p>
}
else if (!passwords.Any())
{
    <div class="glass-card" style="text-align: center; padding: 4rem 2rem;">
        <svg style="color: #64748b; margin-bottom: 1rem;" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
        </svg>
        <h3 style="margin-bottom: 0.5rem;">Nenhuma senha encontrada</h3>
        <p style="color: #94a3b8;">Comece adicionando uma nova senha ao seu cofre.</p>
    </div>
}
else
{
    <div class="password-grid">
        @foreach (var entry in passwords)
        {
            var isRevealed = revealedPasswords.Contains(entry.Id);
            var displayPassword = isRevealed ? DecryptPassword(entry.SenhaCriptografada) : new string('•', 8);

            <div class="glass-card password-item">
                <div class="password-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="origin-badge">@entry.Origem</span>
                    <button class="btn" style="background-color: transparent; color: #ef4444; border: 1px solid #ef4444; padding: 0.25rem 0.6rem; font-size: 0.8rem; cursor: pointer; border-radius: 6px; display: flex; align-items: center;" @onclick="() => DeletePassword(entry.Id)" title="Excluir Senha">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        Excluir
                    </button>
                </div>
                
                <div class="password-detail">
                    <span class="detail-label">Usuário</span>
                    <strong style="color: var(--text-color);">@entry.Usuario</strong>
                </div>

                <div class="password-detail" style="margin-top: 1rem;">
                    <span class="detail-label">Senha</span>
                    <div style="display: flex; align-items: center; flex: 1;">
                        <span class="password-display">@displayPassword</span>
                        <button type="button" class="toggle-btn" @onclick="() => ToggleReveal(entry.Id)" title="Mostrar / Ocultar Senha">
                            @if (isRevealed)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PasswordEntry>? passwords;
    private HashSet<int> revealedPasswords = new();

    protected override async Task OnInitializedAsync()
    {
        passwords = await DbContext.PasswordEntries.ToListAsync();
    }

    private void ToggleReveal(int id)
    {
        if (revealedPasswords.Contains(id))
        {
            revealedPasswords.Remove(id);
        }
        else
        {
            revealedPasswords.Add(id);
        }
    }

    private string DecryptPassword(string encrypted)
    {
        try
        {
            return EncryptionService.Decrypt(encrypted);
        }
        catch
        {
            return "Erro ao descriptografar";
        }
    }

    private async Task DeletePassword(int id)
    {
        var entry = await DbContext.PasswordEntries.FindAsync(id);
        if (entry != null)
        {
            DbContext.PasswordEntries.Remove(entry);
            await DbContext.SaveChangesAsync();
            passwords = await DbContext.PasswordEntries.ToListAsync();
        }
    }
}
