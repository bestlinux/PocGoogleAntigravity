@page "/add-password"
@rendermode InteractiveServer
@using PasswordManager.Data
@using PasswordManager.Data.Models
@using PasswordManager.Services
@inject AppDbContext DbContext
@inject EncryptionService EncryptionService
@inject NavigationManager NavigationManager

<PageTitle>Cadastrar Senha</PageTitle>

<div class="glass-card" style="max-width: 600px; margin: 0 auto;">
    <h2 style="margin-bottom: 2rem; color: var(--primary-color);">Nova Senha</h2>

    <EditForm Model="@newPassword" OnValidSubmit="HandleValidSubmit" FormName="AddPasswordForm">
        <DataAnnotationsValidator />
        
        <div class="form-group">
            <label class="form-label" for="origem">Origem (Site / App)</label>
            <InputText id="origem" @bind-Value="newPassword.Origem" class="form-control" placeholder="ex: Google, Facebook, etc." />
            <ValidationMessage For="@(() => newPassword.Origem)" class="validation-message" />
        </div>

        <div class="form-group">
            <label class="form-label" for="usuario">Usuário</label>
            <InputText id="usuario" @bind-Value="newPassword.Usuario" class="form-control" placeholder="ex: joao@email.com" />
            <ValidationMessage For="@(() => newPassword.Usuario)" class="validation-message" />
        </div>

        <div class="form-group">
            <label class="form-label" for="senha">Senha</label>
            <InputText type="password" id="senha" @bind-Value="newPassword.SenhaCriptografada" class="form-control" />
            <ValidationMessage For="@(() => newPassword.SenhaCriptografada)" class="validation-message" />
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Salvar Senha</button>
            <button type="button" class="btn btn-outline" style="flex: 1;" @onclick='() => NavigationManager.NavigateTo("/passwords")'>Cancelar</button>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private PasswordEntry newPassword { get; set; } = new();

    private async Task HandleValidSubmit()
    {
        // Encrypt the password before saving
        var entryToSave = new PasswordEntry
        {
            Origem = newPassword.Origem,
            Usuario = newPassword.Usuario,
            SenhaCriptografada = EncryptionService.Encrypt(newPassword.SenhaCriptografada)
        };

        DbContext.PasswordEntries.Add(entryToSave);
        await DbContext.SaveChangesAsync();
        
        NavigationManager.NavigateTo("/passwords");
    }
}
