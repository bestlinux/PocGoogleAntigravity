@inherits LayoutComponentBase

<div class="app-container">
    <AuthorizeView>
        <Authorized>
            <nav class="navbar">
                <div class="navbar-brand">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Password Manager
                </div>
                <div class="nav-links">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Início</NavLink>
                    <NavLink class="nav-link" href="passwords">Consultar</NavLink>
                    <NavLink class="nav-link" href="add-password">Cadastrar</NavLink>
                    <form action="logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline" style="padding: 0.25rem 0.75rem; margin-left: 1rem;">Sair</button>
                    </form>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="main-content">
        @Body
    </main>

    <div id="blazor-error-ui" data-nosnippet>
        Um erro ocorreu.
        <a href="" class="reload">Recarregar</a>
        <a class="dismiss">🗙</a>
    </div>
</div>
